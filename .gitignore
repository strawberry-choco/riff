# Generated by Cargo
# will have compiled files and executables
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
.idea/

# VS Code
.vscode/

.omo
.scratch
# Local design-tool scratch: generated sample audio, mockup exports, session
# notes. Must never be committed — it holds copyrighted audio files and notes
# containing the author's home directory paths.
.workbuddy/
debug-output.txt

# Golden-image diff artifacts (transient; see docs/engineering/golden-image-testing.md)
tests/snapshots/**/*.diff.png
tests/snapshots/**/*.new.png
tests/snapshots/**/*.old.png
